  "source_policy_id": "m9-astronomy-source-stack-v1",
  "manifest_id": "astronomy-engine-v0-draft",
  "generation_plan_id": "astronomy-engine-v0-generation-plan-draft",
  "implementation_plan_id": "m9-generated-data-implementation-plan-v1",
