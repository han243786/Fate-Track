  "required_inputs": [
    {
      "id": "source-policy",
      "path": "data/generated/astronomy/source-policy.json",
      "required": true
    },
    {
      "id": "draft-manifest",
      "path": "data/generated/astronomy/manifests/astronomy-engine-v0-draft.json",
      "required": true
    },
    {
      "id": "generation-plan",
      "path": "data/generated/astronomy/generation-plan.json",
      "required": true
    },
    {
      "id": "implementation-plan",
      "path": "data/generated/astronomy/implementation-plan.json",
      "required": true
    }
  ],
  "planned_outputs": [
    {
      "path": "data/generated/astronomy/out/solar-terms-1901-2100.json",
      "kind": "solar-term-crossing-table",
      "status": "not_generated",
      "hash_required": true
    },
    {
      "path": "data/generated/astronomy/out/new-moons-1901-2100.json",
      "kind": "new-moon-table",
      "status": "not_generated",
      "hash_required": true
    },
    {
      "path": "data/generated/astronomy/out/lunar-calendar-1901-2100.json",
      "kind": "derived-chinese-calendar-table",
      "status": "not_generated",
      "hash_required": true
    },
    {
      "path": "data/generated/astronomy/out/android-comparison-1901-2100.json",
      "kind": "android-vs-astronomy-comparison",
      "status": "not_generated",
      "hash_required": true
    }
  ],
  "manifest_update_contract": {
    "allowed_before_acceptance": [
      "generation_command.status may move from not_run to dry_run",
      "artifact_hashes.status must remain missing until real generated files exist",
      "acceptance_status must remain not_accepted"
    ],
    "required_before_acceptance": [
      "all planned outputs exist",
      "sha256 hash recorded for every planned output",
      "comparison_report.status is completed",
      "difference_taxonomy.status is classified",
      "golden cases are generated",
      "replay tests exist"
    ]
  },
  "forbidden_in_contract_stage": [
    "write planned output files",
    "mark artifact hash present",
    "mark manifest accepted",
    "change runtime date-layer behavior",
    "replace android-date-layer-v1",
    "claim astronomy-engine supported"
  ]
}
